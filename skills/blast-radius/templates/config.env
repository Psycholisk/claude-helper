# Delivery skills config: shared by /blast-radius, /qa-it and /ship-it.
#
# Lives at ~/.claude/delivery-skills/config.env (override the folder with $DELIVERY_SKILLS_HOME),
# outside the skills folder, so `git pull` on the skills never overwrites your values.
# The scripts `source` this file, so keep it valid shell: KEY="value", no spaces around "=".
# A value still shaped like <...> is unset: the skills ask for it once and write it back here.

# ── Ticket tracker ────────────────────────────────────────────────────────────────────────
TRACKER="<shortcut | linear | jira | github>"
# How ticket IDs appear in branch names and PR titles, e.g. "sc-" (sc-123), "ENG-" (ENG-42).
TICKET_PREFIX="<sc->"
# The state a shipped ticket moves to, by name (the skill looks up its ID).
TICKET_DONE_STATE="<Completed>"
# The state a ticket sits in while waiting for QA (used to spot work in flight).
TICKET_QA_STATE="<Ready for QA>"

# ── Code ──────────────────────────────────────────────────────────────────────────────────
# GitHub org (or user) that owns the repos.
GH_ORG="<your-github-org>"
# Root folder of your local clones, and the globs under it that hold one clone each.
CODE_ROOT="$HOME/<code>"
REPO_GLOBS="<* | apps/* services/* libraries/*>"
# Repos grep_all_repos.sh skips unless run with -a (huge or legacy ones), space-separated.
SLOW_REPOS=""

# ── Deploys ───────────────────────────────────────────────────────────────────────────────
# Branch whose code is production, and the QA branch (empty if you have no staging branch).
PROD_BRANCH="main"
STAGING_BRANCH="staging"
# GitOps deploy-bump commits, if your CI writes them (e.g. "[no ci] Bump prod to 1234" touching
# deliver_vars/). Leave BUMP_PATH empty to rely on GitHub Deployments only.
BUMP_PATH=""
BUMP_PREFIX="[no ci] Bump"
PROD_BUMP_ENV="prod"
STAGING_BUMP_ENV="staging"
# GitHub Deployment environment names used as the fallback signal (case-insensitive).
PROD_DEPLOY_ENV="production"
STAGING_DEPLOY_ENV="staging"

# ── Time ──────────────────────────────────────────────────────────────────────────────────
TIMEZONE="<Europe/London>"
WORK_DAYS="Mon-Fri"
# Time of day monitoring checks are due.
CHECK_TIME="10:00"

# ── People and tools ──────────────────────────────────────────────────────────────────────
# Your name as it appears in reports ("confirmed by <OWNER_NAME>").
OWNER_NAME="<your name>"
# Chat tool for announcements, and your own user ID there (for @-mentions).
CHAT_TOOL="<slack | teams | none>"
OWNER_CHAT_ID="<U0123456789>"
# Todo app for monitoring reminders. "none" makes ship-it print the plan instead of creating tasks.
TODO_APP="<ticktick | todoist | things | reminders | none>"
TODO_PROJECT="<project or list name, plus its ID if the app needs one>"
